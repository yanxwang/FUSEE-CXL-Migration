#!/usr/bin/env bash
# iter-4A H4 hard enforcement: protocol-A commits MUST cite an
# invariant (I1..I12), anti-pattern (AP1..AP16), or validation gate
# (G1..G6) in the commit message.
# (AP16 + G6 added iter-5A; iter-6A extended protected globs to
#  cxl_inval_ring + cxl_probe.)
#
# Spec: docs/design_goals.md §X H4.
#
# Install: from repo root, run
#     git config core.hooksPath scripts/git-hooks
# Then this hook runs on every commit.

set -u

# Files whose modification triggers the cite requirement.
PROTECTED_GLOBS=(
  'src/cxl_kv_ops_A\.(h|cc)'
  'src/cxl_directory\.(h|cc)'
  'src/cxl_sharding\.(h|cc)'
  'src/cxl_cache_pool\.(h|cc)'
  'src/cxl_kv_blockpool\.(h|cc)'
  'src/cxl_kv_blockpool_freelist\.(h|cc)'
  'src/cxl_forward_ring\.h'
  'src/cxl_inval_ring\.h'
  'src/cxl_probe\.(h|cc)'
)

# Get list of staged files.
files=$(git diff --cached --name-only)
hit=0
for f in $files; do
  for g in "${PROTECTED_GLOBS[@]}"; do
    if [[ "$f" =~ ^$g$ ]]; then
      hit=1
      break
    fi
  done
done

if [[ $hit -eq 0 ]]; then
  exit 0  # no protected files modified
fi

# Read commit message (passed via --message or temp file).
msg_file="${1:-.git/COMMIT_EDITMSG}"
if [[ ! -r "$msg_file" ]]; then
  echo "pre-commit: cannot read commit message at $msg_file" >&2
  exit 1
fi

if grep -qE '\b[Ii]([1-9]|1[0-2])\b|\bAP([1-9]|1[0-5])\b' "$msg_file"; then
  exit 0
fi

cat >&2 <<EOF
pre-commit (H4): commit modifies protocol A file but message has
no invariant (I1..I12), anti-pattern (AP1..AP16), or validation
gate (G1..G6) reference. Per spec §X H4, every protocol A commit
must cite which invariant/AP/G this change relates to.

Add a citation like [I9 fix race], [AP16 cxl atomic], or
[G6 rw race] to the commit subject. To bypass for documentation-only
changes, use:
    git commit --no-verify
(do not use --no-verify for actual code changes; the gate is there
 to prevent silent spec drift, not to be skipped).
EOF
exit 1
